# R session/workspace state
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# Local library and build artifacts
.Rlib/
*.tar.gz
*.Rcheck/
Rplots.pdf

# Compiled kernel objects (src/ng_kernels.cpp is built on install)
src/*.o
src/*.so
src/*.dll

# Run outputs
results/

# Benchmark cache regenerated by tools/run_optimizer_benchmark.R. It lands under inst/,
# which ships in the tarball, so it must never be committed.
inst/fixtures/

# OS cruft
.DS_Store
